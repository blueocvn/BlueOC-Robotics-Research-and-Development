<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Template for the Fast DDS participant profile.
  The real interface IP is injected at runtime by run_workstation.sh from
  network.env (WORKSTATION_IP). The rendered fastdds.xml is gitignored.
-->
<profiles>
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>CustomUDPTransport</transport_id>
            <type>UDPv4</type>
            <interfaceWhiteList>
                <address>${WORKSTATION_IP}</address>
            </interfaceWhiteList>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="CustomParticipant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>CustomUDPTransport</transport_id>
            </userTransports>
        </rtps>
    </participant>
</profiles>
