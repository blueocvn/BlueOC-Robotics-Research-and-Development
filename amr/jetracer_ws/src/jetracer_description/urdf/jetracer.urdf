<?xml version="1.0"?>
<robot name="jetracer">

  <!-- Base footprint / Ground Project Layout -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Elevate chassis based on tire radius -->
    <origin xyz="0 0 0.0325" rpy="0 0 0"/>
  </joint>

  <!-- Physical Metal Chassis Frame -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.25 0.12 0.05"/>
      </geometry>
      <material name="blue"><color rgba="0 0 0.8 1"/></material>
    </visual>
  </link>

  <!-- ==================== ACTUATORS (REAR AXLE) ==================== -->

  <!-- Rear Left Wheel -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <!-- Positioned at rear axle line (-0.1m) -->
    <origin xyz="-0.1 0.075 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rear_left_wheel">
    <visual>
      <geometry><cylinder radius="0.0325" length="0.03"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
  </link>

  <!-- Rear Right Wheel -->
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.1 -0.075 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>
  <link name="rear_right_wheel">
    <visual>
      <geometry><cylinder radius="0.0325" length="0.03"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
  </link>

  <!-- ==================== VIRTUAL STEERING (FRONT AXLE) ==================== -->

  <!-- Virtual central steering pivot point for ros2_control math -->
  <joint name="virtual_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_steer_link"/>
    <!-- Base center to front steering axle = +0.1m (Total 0.2m Wheelbase) -->
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.52" upper="0.52" effort="10.0" velocity="1.0"/>
  </joint>
  <link name="front_steer_link"/>

  <!-- ==================== SENSORS ==================== -->

  <!-- Onboard IMU (MPU9250 / ICM20948) -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_imu_link"/>
    <origin xyz="0.02 0 0.02" rpy="0 0 0"/>
  </joint>
  <link name="base_imu_link"/>

  <!-- RPLidar A1 (Raised via mounting standoff) -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <!-- Mounted forward on the top plate -->
    <origin xyz="0.05 0.0 0.09" rpy="0 0 0"/>
  </joint>
  <link name="laser"/>

  <!-- IMX219 Camera Framework -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.12 0.0 0.07" rpy="0 0.25 0"/>
  </joint>
  <link name="camera_link"/>

  <!-- Camera Optical View Alignment -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="camera_optical_frame"/>

  <!-- ==================== ROS2 CONTROL HARDWARE INTERFACE ==================== -->

  <ros2_control name="WaveshareJetRacerHardware" type="system">
    <hardware>
      <plugin>jetracer_hardware/JetRacerHardwareInterface</plugin>
      <param name="serial_port">/dev/ttyACM0</param>
      <param name="baud_rate">115200</param>
    </hardware>

    <!-- Track the two main driving wheels -->
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="velocity" />
      <state_interface name="position" />
    </joint>

    <!-- Connect your servo to the central pivot -->
    <joint name="virtual_steering_joint">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>
  </ros2_control>

</robot>
