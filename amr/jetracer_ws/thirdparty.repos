# Third-party ROS 2 (Humble) packages for the jetracer AMR workspace.
#
# Reproduce on a fresh checkout:
#     cd amr/jetracer_ws
#     vcs import src < thirdparty.repos
#     patch -p1 -d src/navigation2         < patches/nav2_util-bond-shared_ptr.patch
#     patch -p1 -d src/robot_localization  < patches/robot_localization-ekf-jetracer-tune.patch
#     colcon build --symlink-install
#
# Every entry below was byte-diffed against its pinned tag on 2026-07-10 and
# confirmed to match upstream (ignoring build artifacts). Local modifications
# are carried as patches in patches/ instead of vendoring the source:
#   - navigation2:        nav2_util bond_ unique_ptr -> shared_ptr
#   - robot_localization: params/ekf.yaml jetracer tune (freq, base_footprint)
# (Stray IDE import-path edits in bond_core/geographic_info were NOT real
# changes; a fresh import restores the correct upstream imports.)
#
# NOT listed here (committed directly into git instead):
#   - no upstream release tag matches their <version>:
#       gscam2, m-explore-ros2, nav2_graceful_controller, navigation_msgs (map_msgs)
#   - working copy is newer than / on a different branch from any tag, so a
#     tag pin would REGRESS the robot:
#       apriltag (past v3.4.5: adds aruco + pose estimation)
#       rplidar_ros (ROS 2 branch with C1 support; tags are ROS 1)
repositories:
  angles:
    type: git
    url: https://github.com/ros/angles.git
    version: 1.15.0
  apriltag_msgs:
    type: git
    url: https://github.com/christianrauch/apriltag_msgs.git
    version: 2.0.2
  BehaviorTree.CPP:
    type: git
    url: https://github.com/BehaviorTree/BehaviorTree.CPP.git
    version: 3.8.8
  bond_core:
    type: git
    url: https://github.com/ros/bond_core.git
    version: 4.4.0
  diagnostics:
    type: git
    url: https://github.com/ros/diagnostics.git
    version: 4.0.7
  geographic_info:
    type: git
    url: https://github.com/ros-geographic-info/geographic_info.git
    version: 1.0.7
  laser_geometry:
    type: git
    url: https://github.com/ros-perception/laser_geometry.git
    version: 2.9.0
  navigation2:
    type: git
    url: https://github.com/ros-planning/navigation2.git
    version: 1.1.5
  robot_localization:
    type: git
    url: https://github.com/cra-ros-pkg/robot_localization.git
    version: 3.5.4
  teleop_twist_keyboard:
    type: git
    url: https://github.com/ros2/teleop_twist_keyboard.git
    version: 2.4.1
