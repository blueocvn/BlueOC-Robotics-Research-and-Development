#usda 1.0
(
    defaultPrim = "JetRacer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "JetRacer" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def Cube "chassis" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        float physics:mass = 0.25
        color3f[] primvars:displayColor = [(0.2, 0.35, 0.7)]
        double size = 1
        # Y (width) narrowed from 0.16 to 0.11: at 0.16 the chassis half-width (0.08) nearly
        # equals the wheel-hub offsets (0.0825 front / 0.09 rear), so the wheels ended up ~11mm
        # (front) / ~3.5mm (rear) EMBEDDED inside the chassis box -- most of each wheel's 27mm
        # thickness was hidden inside the body instead of standing clear on an axle, which reads
        # as "wheels bunched near the center" rather than at the four corners. 0.11 gives every
        # wheel >10mm of clear stick-out. Only wheelbase/track/wheel-size are guide-specified
        # "measured" values; this chassis width was always an approximate "~0.16m" placeholder.
        float3 xformOp:scale = (0.3, 0.11, 0.05)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "steer_link_L" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.01
        color3f[] primvars:displayColor = [(0.15, 0.15, 0.15)]
        double size = 1
        float3 xformOp:scale = (0.02, 0.02, 0.02)
        double3 xformOp:translate = (0.08, 0.0825, -0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def PhysicsRevoluteJoint "steer_joint_L" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 5
        float drive:angular:physics:maxForce = 2
        float drive:angular:physics:stiffness = 50
        float drive:angular:physics:targetPosition = 0
        float drive:angular:physics:targetVelocity = 0
        uniform token drive:angular:physics:type = "position"
        uniform token physics:axis = "Z"
        rel physics:body0 = </JetRacer/chassis>
        rel physics:body1 = </JetRacer/steer_link_L>
        point3f physics:localPos0 = (0.08, 0.0825, -0.03)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -30
        float physics:upperLimit = 30
    }

    def Cylinder "wheel_FL" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.027
        float physics:mass = 0.02
        color3f[] primvars:displayColor = [(0.05, 0.05, 0.05)]
        double radius = 0.0325
        double3 xformOp:translate = (0.08, 0.0825, -0.03)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def PhysicsRevoluteJoint "wheel_joint_FL"
    {
        uniform token physics:axis = "Y"
        rel physics:body0 = </JetRacer/steer_link_L>
        rel physics:body1 = </JetRacer/wheel_FL>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }

    def Cube "steer_link_R" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.01
        color3f[] primvars:displayColor = [(0.15, 0.15, 0.15)]
        double size = 1
        float3 xformOp:scale = (0.02, 0.02, 0.02)
        double3 xformOp:translate = (0.08, -0.0825, -0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def PhysicsRevoluteJoint "steer_joint_R" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 5
        float drive:angular:physics:maxForce = 2
        float drive:angular:physics:stiffness = 50
        float drive:angular:physics:targetPosition = 0
        float drive:angular:physics:targetVelocity = 0
        uniform token drive:angular:physics:type = "position"
        uniform token physics:axis = "Z"
        rel physics:body0 = </JetRacer/chassis>
        rel physics:body1 = </JetRacer/steer_link_R>
        point3f physics:localPos0 = (0.08, -0.0825, -0.03)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -30
        float physics:upperLimit = 30
    }

    def Cylinder "wheel_FR" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.027
        float physics:mass = 0.02
        color3f[] primvars:displayColor = [(0.05, 0.05, 0.05)]
        double radius = 0.0325
        double3 xformOp:translate = (0.08, -0.0825, -0.03)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def PhysicsRevoluteJoint "wheel_joint_FR"
    {
        uniform token physics:axis = "Y"
        rel physics:body0 = </JetRacer/steer_link_R>
        rel physics:body1 = </JetRacer/wheel_FR>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }

    def Cylinder "wheel_RL" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.027
        float physics:mass = 0.02
        color3f[] primvars:displayColor = [(0.05, 0.05, 0.05)]
        double radius = 0.0325
        double3 xformOp:translate = (-0.08, 0.09, -0.03)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def PhysicsRevoluteJoint "wheel_joint_RL" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 50
        float drive:angular:physics:maxForce = 1
        float drive:angular:physics:stiffness = 0
        float drive:angular:physics:targetPosition = 0
        float drive:angular:physics:targetVelocity = 0
        uniform token drive:angular:physics:type = "velocity"
        uniform token physics:axis = "Y"
        rel physics:body0 = </JetRacer/chassis>
        rel physics:body1 = </JetRacer/wheel_RL>
        point3f physics:localPos0 = (-0.08, 0.09, -0.03)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }

    def Cylinder "wheel_RR" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Y"
        double height = 0.027
        float physics:mass = 0.02
        color3f[] primvars:displayColor = [(0.05, 0.05, 0.05)]
        double radius = 0.0325
        double3 xformOp:translate = (-0.08, -0.09, -0.03)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def PhysicsRevoluteJoint "wheel_joint_RR" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 50
        float drive:angular:physics:maxForce = 1
        float drive:angular:physics:stiffness = 0
        float drive:angular:physics:targetPosition = 0
        float drive:angular:physics:targetVelocity = 0
        uniform token drive:angular:physics:type = "velocity"
        uniform token physics:axis = "Y"
        rel physics:body0 = </JetRacer/chassis>
        rel physics:body1 = </JetRacer/wheel_RR>
        point3f physics:localPos0 = (-0.08, -0.09, -0.03)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }

    def Xform "front_cam_mount"
    {
        double3 xformOp:translate = (0.16, 0, 0.07)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

