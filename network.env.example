# Network configuration for the ROS 2 / DDS setup.
#
# Copy this file to `network.env` and fill in your real values:
#     cp network.env.example network.env
#
# `network.env` is gitignored, so your real IPs never get committed.
# All run scripts (jetracer_ws/run_workstation.sh, orchestrator_ws/run_web_bridge.sh)
# source it automatically from the repo root.

# Shared DDS domain — every workspace must use the same ID to see each other.
export ROS_DOMAIN_ID=42

# LAN IPs of the two DDS peers.
export WORKSTATION_IP=192.168.XX.XX
export JETRACER_IP=192.168.XX.XX

# Network interface the workstation uses for ROS 2 traffic (e.g. eth0, wlp4s0).
export DDS_INTERFACE=eth0
